# Production environment template.
# Copy to .env.production for Docker Compose and replace every CHANGE_THIS value.
# On Render, configure these values in the service environment instead of committing secrets.

ENVIRONMENT=production

POSTGRES_DB=marcenaria_db
POSTGRES_USER=marcenaria
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://marcenaria:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/marcenaria_db

# Docker Compose uses the redis service below. On Render, use the private/internal
# connection URL from the Render Key Value instance.
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=120

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pydantic parses list settings from environment variables as JSON.
CORS_ORIGINS=["https://ideal-marcenaria.onrender.com"]
FRONTEND_URL=https://ideal-marcenaria.onrender.com

# Optional SMTP for real password-reset email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_THIS
SMTP_PASSWORD=CHANGE_THIS
SMTP_FROM=Marcenaria Ideal <no-reply@example.com>
PASSWORD_RESET_EXPIRE_MINUTES=30
