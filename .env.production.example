# Production environment template.
# Copy to .env.production for Docker Compose and replace every CHANGE_THIS value.
# On Render, configure these values in the service environment instead of committing secrets.

ENVIRONMENT=production

POSTGRES_DB=marcenaria_db
POSTGRES_USER=marcenaria
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://marcenaria:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/marcenaria_db
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Docker Compose uses the redis service below. On Render, use the private/internal
# connection URL from the Render Key Value instance.
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=1
RATE_LIMIT_PER_MINUTE=120

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pydantic parses list settings from environment variables as JSON.
CORS_ORIGINS=["https://ideal-marcenaria.onrender.com"]
FRONTEND_URL=https://ideal-marcenaria.onrender.com

# Email stays disabled until a verified sender/provider is configured.
# Render Free blocks standard SMTP ports; use resend HTTPS or compatible hosting.
# See docs/email-setup.md. Set secrets directly in the backend environment.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_EXPIRE_MINUTES=30
# Billing stays disabled until provider, price IDs and webhook secret are approved.
BILLING_PROVIDER=disabled
BILLING_WEBHOOK_SECRET=
# Set only for one controlled migration when promoting an existing platform operator.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
